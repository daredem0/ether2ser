.program tck_txd
; Generate a tx clock and write out bits
; Additionally prevents data from being pushed out unles
; CTS is registered

.side_set 1

.wrap_target
    wait_cts:   jmp pin, send   side 0
                jmp wait_cts    side 0

    send:       out pins, 1     side 1
                nop             side 0
.wrap


