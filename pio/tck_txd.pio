.program tck_txd
.side_set 1
.wrap_target
bitloop:
    jmp pin send    side 0 [1]   ; 2 cycles low, CTS check
    jmp bitloop     side 0 [1]   ; CTS not ready -> hold clock low

send:
    out pins, 1     side 0 [1]   ; 2 cycles low, shift data bit
    nop             side 1 [1]   ; 2 cycles high
    jmp bitloop     side 1 [1]   ; 2 cycles high
.wrap
